# Base URL of the Service Request API.
VITE_API_BASE_URL=/api

# "true" = use the MSW fake backend (no real server needed).
VITE_ENABLE_MOCKS=true

# --- Sign-in (OpenID Connect) ---
# The issuer URL of your OIDC provider. For the local Keycloak (docker compose up):
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/request-hub
# The PUBLIC client for this app (Authorization Code + PKCE, no client secret).
VITE_OIDC_CLIENT_ID=request-hub-rh
# Where the provider sends users back after sign-in. Must be allowed in the client settings.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Optional. Default: openid profile email
# VITE_OIDC_SCOPE=openid profile email
#
# No sign-in server at hand? Leave VITE_OIDC_AUTHORITY empty while VITE_ENABLE_MOCKS=true
# and the app signs you in as a demo user.